{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReflectMaps",
  "identifier": "io.github.handyfox.reflectmaps",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ReflectMaps",
        "width": 1320,
        "height": 840,
        "minWidth": 820,
        "minHeight": 560,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Travel",
    "shortDescription": "Offline maps, search and directions",
    "longDescription": "ReflectMaps works without an internet connection: download the states you need, then browse, search places and addresses, and plan driving routes offline.",
    "copyright": "ReflectMaps contributors. Map data \u00a9 OpenStreetMap contributors, Overture Maps Foundation.",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
